{
  "name": "axiom",
  "version": "0.1.0-alpha",
  "description": "Bitbucket + Jira + Confluence in one. Markdown-first. Built-in MCP for Claude.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:setup-admin": "tsx scripts/setup-admin.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:seed:voorbeeld": "tsx scripts/seed-voorbeeld.ts",
    "db:seed": "tsx scripts/seed-demo.ts && tsx scripts/seed-voorbeeld.ts",
    "db:seed:prod": "tsx scripts/seed-production.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:run",
    "docker:dev": "docker compose -f docker-compose.dev.yml --profile ssh up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml --profile ssh down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "tunnel": "docker compose -f docker-compose.dev.yml --profile tunnel up -d tunnel && docker compose -f docker-compose.dev.yml logs -f tunnel",
    "tunnel:down": "docker compose -f docker-compose.dev.yml --profile tunnel stop tunnel",
    "docker:prod": "docker compose up -d",
    "docker:prod:down": "docker compose down",
    "docker:prod:build": "docker compose build",
    "e2e": "bash scripts/run-e2e.sh",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "version:patch": "npm version patch --preid=alpha",
    "version:minor": "npm version minor --preid=alpha",
    "version:major": "npm version major --preid=alpha",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/express-api-reference": "^0.9.6",
    "@types/nodemailer": "^7.0.11",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.1",
    "cors": "^2.8.6",
    "diff": "^8.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^17.0.5",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "otplib": "^13.4.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "ws": "^8.20.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30",
    "zod": "^4.3.6",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^62.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "npx eslint --fix --config frontend/eslint.config.mjs",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
