# =============================================================================
# Axiom Production Environment -- aranea.dev
# =============================================================================
# Copy to .env and fill in all values.
# Generate secrets with: openssl rand -hex 32

# -- Domain ------------------------------------------------------------------
DOMAIN=aranea.dev
CORS_ORIGIN=https://aranea.dev
FRONTEND_URL=https://aranea.dev

# -- Database -----------------------------------------------------------------
POSTGRES_DB=axiom
POSTGRES_USER=axiom
POSTGRES_PASSWORD=   # openssl rand -hex 32

# -- Redis --------------------------------------------------------------------
REDIS_PASSWORD=      # openssl rand -hex 32

# -- Authentication -----------------------------------------------------------
JWT_SECRET=          # openssl rand -hex 32
JWT_REFRESH_SECRET=  # openssl rand -hex 32

# -- Git Hooks ----------------------------------------------------------------
HOOK_SECRET=         # openssl rand -hex 16

# -- Admin Seed ---------------------------------------------------------------
# Password for the initial tim user. Used by: npm run db:seed:prod
ADMIN_PASSWORD=      # strong password

# -- Email (Gmail) ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=           # your-gmail@gmail.com
SMTP_PASS=           # Gmail App Password (16-char, not your Gmail password)
SMTP_FROM="Axiom <your-gmail@gmail.com>"

# -- Internal -----------------------------------------------------------------
# Internal base URL of the API, used by git hooks to report pushes.
# In Docker: http://api:3000. Running the API on the host: http://localhost:3000.
AXIOM_INTERNAL_URL=http://api:3000

# -- SSH git access -------------------------------------------------------------
# The git-ssh container runs only with the "ssh" compose profile.
# Change COMPOSE_PROFILES and SSH_ENABLED together.
COMPOSE_PROFILES=ssh
SSH_ENABLED=true
# Host port published for git-ssh.
SSH_PORT=2222
# Host and port shown in clone URLs. Unset host: the browser's hostname.
# Set SSH_PUBLIC_PORT=22 when the host forwards port 22 to Axiom.
SSH_PUBLIC_HOST=aranea.dev
SSH_PUBLIC_PORT=

# -- Ports --------------------------------------------------------------------
# The port exposed on the host. ProxyPilot reverse proxy targets this.
PORT=7000
