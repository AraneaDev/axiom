    "dompurify": "^3.3.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.460.0",
    "marked": "^17.0.4",
    "mermaid": "^11.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "tailwind-merge": "^2.6.0",
    "tippy.js": "^6.3.7",
    "tiptap-markdown": "^0.9.0",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "^3.0.0",
