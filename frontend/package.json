{
  "name": "axiom-frontend",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "vitest",
    "test:run": "vitest run"
  },
