DATABASE_URL="postgresql://postgres:postgres@localhost:5432/axiom?schema=public"
JWT_SECRET="change-me-to-a-random-secret"
JWT_REFRESH_SECRET="change-me-to-another-random-secret"
PORT=3000
NODE_ENV=development

# Comma-separated allowed origins for CORS. Use * to allow all (dev only).
# In production, set to your actual domain (e.g., https://axiom.example.com).
CORS_ORIGIN=http://localhost:7000

# Path where bare git repositories are stored on disk.
# In dev: .data/repos/ (bind mount). In production: /data/repos (Docker volume).
REPOS_PATH=.data/repos

# Path for general file storage (uploads, attachments).
STORAGE_PATH=.data/uploads

# Frontend API base URL used by Vite during build/dev.
VITE_API_URL=http://localhost:3000

# Public URL of the frontend app (used in email links, etc.).
FRONTEND_URL=http://localhost:7000

# Internal base URL of the API, used by git hooks to report pushes.
# In Docker: http://api:3000. Running the API on the host: http://localhost:3000.
AXIOM_INTERNAL_URL=http://localhost:3000

# Redis URL. Optional in dev (the app works without Redis). The dev compose Redis
# requires a password: redis://:axiom_dev_redis@localhost:6379
REDIS_URL=redis://:axiom_dev_redis@localhost:6379

# Shared secret for internal git post-receive hook verification.
# Must match between the API server and the hook script.
HOOK_SECRET=axiom-internal-hook-secret

# Entry point for the git post-receive hook script. Only needed when running
# the API on the host instead of in Docker: point it at <repo>/src/git/post-receive-hook.ts
# so host-run repos don't fall back to the /app/dist path baked in for the container image.
# Leave unset inside Docker.
AXIOM_HOOK_ENTRY=

# SMTP settings for email notifications.
# When SMTP_HOST is not set, email delivery is disabled (app works without it).
# In dev: docker-mailserver handles SMTP on port 25 automatically.
# In prod: use any SMTP provider (SendGrid, SES, etc.).
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Axiom <noreply@axiom.local>"

# SSH git access. The git-ssh container runs only with the "ssh" compose profile.
# Change COMPOSE_PROFILES and SSH_ENABLED together.
COMPOSE_PROFILES=ssh
SSH_ENABLED=true
# Host port published for git-ssh.
SSH_PORT=2222
# Host and port shown in clone URLs. Unset host: the browser's hostname.
# Set SSH_PUBLIC_PORT=22 when the host forwards port 22 to Axiom.
SSH_PUBLIC_HOST=
SSH_PUBLIC_PORT=
