# =============================================================================
# Axiom Staging/Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Required values are marked with [REQUIRED].
#
# Generate secrets with: openssl rand -hex 32

# -- Domain ------------------------------------------------------------------
# [REQUIRED] The public domain where Axiom is accessible.
# Used for CORS, email links, and git clone URLs.
DOMAIN=staging.example.com
CORS_ORIGIN=https://staging.example.com
FRONTEND_URL=https://staging.example.com

# -- Database -----------------------------------------------------------------
# [REQUIRED] PostgreSQL credentials. The DATABASE_URL is composed automatically
# in docker-compose.yml from these values.
POSTGRES_DB=axiom
POSTGRES_USER=axiom
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# -- Redis --------------------------------------------------------------------
# [REQUIRED] Password for the Redis container. Docker Compose exits immediately
# if it is unset.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# -- Authentication -----------------------------------------------------------
# [REQUIRED] JWT signing secrets. Must be at least 32 characters each.
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# -- Git Hooks ----------------------------------------------------------------
# Shared secret for internal git post-receive hook verification.
# Generate with: openssl rand -hex 16
HOOK_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_16

# -- Email (SMTP) -------------------------------------------------------------
# Configure a real SMTP provider (SendGrid, SES, Mailgun, etc.).
# Leave SMTP_HOST empty to disable email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Axiom <noreply@staging.example.com>"

# -- Internal -------------------------------------------------------------------
# Internal base URL of the API, used by git hooks to report pushes.
# In Docker: http://api:3000. Running the API on the host: http://localhost:3000.
AXIOM_INTERNAL_URL=http://api:3000

# -- SSH git access -------------------------------------------------------------
# The git-ssh container runs only with the "ssh" compose profile.
# Change COMPOSE_PROFILES and SSH_ENABLED together.
COMPOSE_PROFILES=ssh
SSH_ENABLED=true
# Host port published for git-ssh.
SSH_PORT=2222
# Host and port shown in clone URLs. Unset host: the browser's hostname.
# Set SSH_PUBLIC_PORT=22 when the host forwards port 22 to Axiom.
SSH_PUBLIC_HOST=staging.example.com
SSH_PUBLIC_PORT=

# -- Ports --------------------------------------------------------------------
# The port exposed on the host. Apache/nginx reverse proxy targets this.
PORT=7000
