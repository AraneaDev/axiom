FROM node:25-alpine
RUN apk add --no-cache git pandoc weasyprint font-noto
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npx prisma generate

COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts

EXPOSE 3000

# tsx watch for HMR on backend
CMD ["sh", "-c", "npx prisma generate && npx tsx watch src/index.ts"]
