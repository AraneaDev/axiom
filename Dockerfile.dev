FROM node:22-alpine
RUN apk add --no-cache git
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci
COPY prisma ./prisma
RUN npx prisma generate

COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts

EXPOSE 3000

# tsx watch for HMR on backend
CMD ["sh", "-c", "npx prisma migrate deploy && npx tsx watch src/index.ts"]
