// ─── Approval Workflows ─────────────────────────────────────

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model ApprovalGate {
  id                String   @id @default(cuid())
  projectId         String
  fromColumnId      String
  toColumnId        String
  minApprovals      Int      @default(1)
  allowSelfApproval Boolean  @default(false)
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromColumn BoardColumn       @relation("approvalGateFrom", fields: [fromColumnId], references: [id], onDelete: Cascade)
  toColumn   BoardColumn       @relation("approvalGateTo", fields: [toColumnId], references: [id], onDelete: Cascade)
  requests   ApprovalRequest[]

  @@unique([projectId, fromColumnId, toColumnId])
  @@index([projectId])
  @@map("approval_gates")
}

model ApprovalRequest {
  id             String                @id @default(cuid())
  issueId        String
  approvalGateId String
  targetColumnId String
  requestedById  String
  /// The users asked to approve; only they can vote
  approverIds    String[]              @default([])
  status         ApprovalRequestStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  resolvedAt     DateTime?

  issue        Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  approvalGate ApprovalGate   @relation(fields: [approvalGateId], references: [id], onDelete: Cascade)
  targetColumn BoardColumn    @relation("approvalRequestTarget", fields: [targetColumnId], references: [id], onDelete: Cascade)
  requestedBy  User           @relation("approvalRequester", fields: [requestedById], references: [id])
  votes        ApprovalVote[]

  @@index([issueId])
  @@index([approvalGateId])
  @@index([requestedById, status])
  @@map("approval_requests")
}

model ApprovalVote {
  id                String           @id @default(cuid())
  approvalRequestId String
  userId            String
  decision          ApprovalDecision
  comment           String?
  createdAt         DateTime         @default(now())

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])

  @@unique([approvalRequestId, userId])
  @@index([userId])
  @@map("approval_votes")
}

// ─── Public Intake Forms ─────────────────────────────────────

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormAuthMode {
  PUBLIC
  TOKEN_GATED
}

enum FormSpamProtection {
  NONE
  CAPTCHA
  RATE_LIMIT
}

enum FormFieldType {
  TEXT
  TEXTAREA
  SELECT
  MULTISELECT
  CHECKBOX
  RADIO
  DATE
  FILE
  HEADING
  DESCRIPTION
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

model Form {
  id               String             @id @default(cuid())
  projectId        String
  name             String
  slug             String             @unique
  description      String?
  status           FormStatus         @default(DRAFT)
  authMode         FormAuthMode       @default(PUBLIC)
  sharedSecret     String?
  spamProtection   FormSpamProtection @default(NONE)
  rateLimitPerHour Int?
  successMessage   String?
  redirectUrl      String?
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("formCreator", fields: [createdById], references: [id])
  pages       FormPage[]
  submissions FormSubmission[]

  @@index([projectId])
}

model FormPage {
  id                String  @id @default(cuid())
  formId            String
  title             String
  position          Int
  conditionFieldId  String?
  conditionOperator String?
  conditionValue    String?

  form           Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  conditionField FormField?  @relation("pageCondition", fields: [conditionFieldId], references: [id], onDelete: SetNull)
  fields         FormField[] @relation("pageFields")

  @@index([formId])
}

model FormField {
  id                String        @id @default(cuid())
  formPageId        String
  position          Int
  type              FormFieldType
  label             String
  placeholder       String?
  helpText          String?
  required          Boolean       @default(false)
  options           Json?
  issueFieldMapping String?
  validationRules   Json?

  page           FormPage   @relation("pageFields", fields: [formPageId], references: [id], onDelete: Cascade)
  conditionPages FormPage[] @relation("pageCondition")

  @@index([formPageId])
}

model FormSubmission {
  id             String           @id @default(cuid())
  formId         String
  projectId      String
  status         SubmissionStatus @default(PENDING)
  data           Json
  submitterEmail String?
  submitterName  String?
  submitterIp    String
  issueId        String?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime         @default(now())

  form       Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue      Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)
  reviewedBy User?   @relation("submissionReviewer", fields: [reviewedById], references: [id])

  @@index([formId, status])
  @@index([projectId, status])
}

// ─── Roadmap ─────────────────────────────────────────────

model RoadmapBucket {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  Int
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
  @@map("roadmap_buckets")
}

// ─── Site Settings (singleton) ──────────────────────────────

model SiteSettings {
  id               Int      @id @default(1)
  heroTitle        String   @default("Code. Track. Document.")
  heroSubtitle     String   @default("Git hosting, issue tracking, and documentation — unified with built-in AI integration.")
  ctaText          String   @default("Get Started")
  ctaLink          String   @default("/register")
  bodyMarkdown     String   @default("")
  registrationMode String   @default("INVITE_ONLY") @map("registration_mode")
  enforce2fa       Boolean  @default(false) @map("enforce_2fa")
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}

enum AgentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
  /// Withdrawn by the system: its service account was deleted or suspended
  CANCELLED
}

/// A token's call that waits for its user to decide in the web UI. Not the issue approval gates.
model AgentApproval {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// No relation: the row outlives the token, and a token that is gone stops the run
  apiTokenId   String?
  apiTokenName String?
  /// The channel of the request, which the run keeps so the audit log says via
  channel      String
  action       String
  input        Json
  preview      String
  status       AgentApprovalStatus @default(PENDING)
  result       Json?
  error        Json?
  decidedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime            @default(now())

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([decidedAt])
  @@map("agent_approvals")
}

/// Rules for what a token's call waits on, per org (set by an owner) or per user (tighten only).
/// Exactly one of orgId and userId is set.
model AgentPolicy {
  id        String        @id @default(cuid())
  orgId     String?       @unique
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String?       @unique
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules     Json
  updatedAt DateTime      @updatedAt

  @@map("agent_policies")
}

/// The one GitHub App of this instance, made through GitHub's manifest flow. The row id is 1.
/// clientSecret, privateKey and webhookSecret are sealed by the secret box (enc:v1:...) with the
/// context githubApp.<field>:1.
model GithubApp {
  id            Int      @id @default(1)
  appId         BigInt
  slug          String
  name          String
  htmlUrl       String
  ownerLogin    String
  clientId      String
  clientSecret  String // enc
  privateKey    String // enc
  webhookSecret String // enc
  createdById   String
  createdAt     DateTime @default(now())

  @@map("github_apps")
}

/// A person's own GitHub account, connected through the App's user authorization. accessToken and
/// refreshToken are sealed by the secret box (enc:v1:...) with the contexts
/// githubAccount.accessToken:<id> and githubAccount.refreshToken:<id>.
model GithubAccount {
  id                    String    @id @default(cuid())
  userId                String    @unique
  githubUserId          BigInt    @unique
  login                 String
  accessToken           String // enc
  accessTokenExpiresAt  DateTime?
  refreshToken          String? // enc
  refreshTokenExpiresAt DateTime?
  /// When this connection was last made: a reconnect sets it again, the row stays
  connectedAt           DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_accounts")
}

/// A setup step started here and finished on GitHub's redirect. The state is single use.
model GithubSetupState {
  state     String   @id
  userId    String
  /// 'manifest' | 'user'
  purpose   String
  expiresAt DateTime

  @@index([expiresAt])
  @@map("github_setup_states")
}

/// An installation of the App on a GitHub account (id as GitHub numbers it)
model GithubInstallation {
  id           BigInt    @id
  accountLogin String
  accountType  String
  suspendedAt  DateTime?
  /// When the installation was deleted, or vanished from the App's list: suspension is separate
  removedAt    DateTime?
  /// When the newest webhook event applied to this row was received (or the last sync ran)
  lastEventAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("github_installations")
}

enum GithubDeliveryStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}

/// One webhook delivery from GitHub (id is X-GitHub-Delivery), kept as the log and the retry queue
model GithubDelivery {
  id             String               @id
  event          String
  action         String?
  installationId BigInt?
  repoId         BigInt?
  status         GithubDeliveryStatus @default(PENDING)
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime?
  error          String?
  payload        Json?
  receivedAt     DateTime             @default(now())
  processedAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([repoId, receivedAt])
  @@map("github_deliveries")
}

/// The one GitHub repository a project is linked to (ids as GitHub numbers them). Deleting the
/// link deletes what the later GitHub tables hold for it.
model GithubRepoLink {
  id                    String              @id @default(cuid())
  projectId             String              @unique
  repoId                BigInt              @unique
  installationId        BigInt
  owner                 String
  name                  String
  fullName              String
  defaultBranch         String
  htmlUrl               String
  /// Who linked it; no relation, so deleting that person does not block or unlink the project
  linkedById            String
  createdAt             DateTime            @default(now())
  lastDeliveryAt        DateTime?
  lastReconciledAt      DateTime?
  lastReconcileError    String?
  reconcileLeaseUntil   DateTime?
  /// Who holds the lease: only that run extends or clears it
  reconcileLeaseToken   String?
  /// Why the last reconcile did not read everything (null when it did)
  lastReconcileNote     String?
  /// When the default rules were made for this link; set once, so a rule the team deleted never returns
  defaultRulesCreatedAt DateTime?
  /// Whether the repository's GitHub Issues are imported into the project
  importIssues          Boolean             @default(false)
  /// When import was last switched from off to on: issues GitHub made before it run no creation rules
  importEnabledAt       DateTime?
  /// How far the reconcile's import catch-up got through the issues GitHub changed (their updated_at)
  importIssuesSeenAt    DateTime?
  /// How far it got through the comments GitHub changed
  importCommentsSeenAt  DateTime?
  /// The wiki space release notes are written to when a request names none (a space of the project's team)
  releaseNotesSpaceId   String?
  releaseNotesSpace     WikiSpace?          @relation(fields: [releaseNotesSpaceId], references: [id], onDelete: SetNull)
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueLinks            GithubIssueLink[]
  branches              GithubBranch[]
  pullRequests          GithubPullRequest[]
  commits               GithubCommit[]
  checkRuns             GithubCheckRun[]
  issueImports          GithubIssueImport[]
  importCaps            GithubImportCap[]
  importRuns            GithubImportRun[]

  @@map("github_repo_links")
}

/// A GitHub Issue imported into the linked project, with what the last import wrote per field
model GithubIssueImport {
  id                   String                  @id @default(cuid())
  /// Null while the repository is unlinked: the row stays, and a new link of the same repository in
  /// the same project takes it back, so its tombstone and link comment survive
  repoLinkId           String?
  /// The project and the GitHub repository the row was imported for, which outlive the link
  projectId            String
  repoId               BigInt
  githubIssueNumber    Int
  githubIssueId        String
  /// Null once the Axiom issue was deleted: the row then keeps the GitHub Issue from coming back
  issueId              String?                 @unique
  /// The title, SHA-256 of the body and label names last taken from GitHub
  mirroredTitle        String
  mirroredBodyHash     String
  mirroredLabels       String[]
  /// The App's comment on GitHub with the Axiom link, once it is posted
  linkCommentId        String?
  /// When a run took the posting of the link comment; one older than 10 minutes may be taken again
  linkCommentClaimedAt DateTime?
  /// When GitHub answered the link comment with 404 or 410, or refused it 5 times: it is not tried again
  linkCommentGivenUpAt DateTime?
  /// How often GitHub refused the link comment (a 4xx other than 404, 410 and 429)
  linkCommentFailures  Int                     @default(0)
  /// When the comments GitHub had at the import were all read
  commentsImportedAt   DateTime?
  githubUpdatedAt      DateTime
  lastImportedAt       DateTime
  repoLink             GithubRepoLink?         @relation(fields: [repoLinkId], references: [id], onDelete: SetNull)
  project              Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue                Issue?                  @relation(fields: [issueId], references: [id], onDelete: SetNull)
  comments             GithubImportedComment[]

  @@unique([repoLinkId, githubIssueNumber])
  @@unique([projectId, repoId, githubIssueNumber])
  @@index([repoLinkId, linkCommentClaimedAt])
  @@map("github_issue_imports")
}

/// What live GitHub events imported into a link in one clock hour, against the hourly cap
model GithubImportCap {
  repoLinkId          String
  /// The start of the clock hour (UTC)
  hourStart           DateTime
  issues              Int            @default(0)
  comments            Int            @default(0)
  /// What the cap turned away in that hour
  skippedIssues       Int            @default(0)
  skippedComments     Int            @default(0)
  /// The issue numbers the cap turned away this hour: each is counted once, however many events
  skippedIssueNumbers Int[]          @default([])
  repoLink            GithubRepoLink @relation(fields: [repoLinkId], references: [id], onDelete: Cascade)

  @@id([repoLinkId, hourStart])
  @@map("github_import_caps")
}

enum GithubImportRunStatus {
  QUEUED
  RUNNING
  PAUSED
  DONE
  FAILED
  CANCELLED
}

/// One backfill of the open GitHub Issues of a link, run by the worker a tick at a time
model GithubImportRun {
  id                    String                @id @default(cuid())
  repoLinkId            String
  /// Who switched import on; no relation, so deleting that person leaves the run as it is
  requestedById         String
  status                GithubImportRunStatus @default(QUEUED)
  /// The open issues GitHub counted when the run started, null when the count could not be read
  total                 Int?
  /// The open issues read so far that are in Axiom, imported by this run or before it
  done                  Int                   @default(0)
  failed                Int                   @default(0)
  /// The page of GitHub's open issues (100 each, oldest first) that is read next
  nextPage              Int                   @default(1)
  /// 1: the first read through the pages; 2: one more read, for issues that moved onto a page
  /// already read when earlier ones closed; 3: the pages are read, link comments are left
  pass                  Int                   @default(1)
  /// `done` of the pages before nextPage in the first pass; in the sweep, its own count of them
  doneBeforePage        Int                   @default(0)
  /// The issues whose import failed: this run does not try them again (their next update does)
  failedNumbers         Int[]                 @default([])
  resumeAt              DateTime?
  /// Until when a tick holds the run; the exact value is that tick's token
  leaseUntil            DateTime?
  /// Set by a failure that may pass; null while the run is fine or only waits for a rate limit
  error                 String?
  /// Ticks in a row that failed with `error`; at 10 the run is FAILED
  errorTicks            Int                   @default(0)
  /// While the link's hourly ceiling of link comments is reached: when the next one may go
  linkCommentsWaitUntil DateTime?
  /// When the run last moved on (an issue, a page or a link comment); a day without is FAILED
  progressAt            DateTime?
  createdAt             DateTime              @default(now())
  startedAt             DateTime?
  finishedAt            DateTime?
  repoLink              GithubRepoLink        @relation(fields: [repoLinkId], references: [id], onDelete: Cascade)

  @@index([repoLinkId, createdAt])
  @@index([status])
  @@map("github_import_runs")
}

/// A GitHub comment imported onto an imported issue, with the hash of the body last taken
model GithubImportedComment {
  importId         String
  githubCommentId  String
  /// Null once the Axiom comment was deleted: the GitHub comment is then not imported again
  commentId        String?           @unique
  mirroredBodyHash String
  githubUpdatedAt  DateTime
  import           GithubIssueImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  comment          Comment?          @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@id([importId, githubCommentId])
  @@map("github_imported_comments")
}

/// One GitHub comment already made by a rule for an issue, trigger, subject (PR or branch id) and head commit
model GithubAutomationMark {
  id         String   @id @default(cuid())
  issueId    String
  trigger    String
  /// The pull request or branch id
  subjectKey String
  headSha    String
  createdAt  DateTime @default(now())
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, trigger, subjectKey, headSha])
  @@index([createdAt])
  @@map("github_automation_marks")
}

enum GithubLinkTarget {
  BRANCH
  PULL_REQUEST
  COMMIT
}

enum GithubLinkSource {
  BRANCH_NAME
  PR_TITLE
  PR_BODY
  COMMIT_MESSAGE
}

/// An issue named by a branch, pull request or commit, and which of its texts named it
model GithubIssueLink {
  id         String             @id @default(cuid())
  issueId    String
  repoLinkId String
  targetType GithubLinkTarget
  /// Branch id, pull request id or commit sha
  targetKey  String
  sources    GithubLinkSource[]
  createdAt  DateTime           @default(now())
  issue      Issue              @relation(fields: [issueId], references: [id], onDelete: Cascade)
  repoLink   GithubRepoLink     @relation(fields: [repoLinkId], references: [id], onDelete: Cascade)

  @@unique([issueId, targetType, targetKey])
  @@index([repoLinkId, targetType, targetKey])
  @@map("github_issue_links")
}

/// A branch of a linked repository; `deletedAt` marks one deleted on GitHub (its issue links stay)
model GithubBranch {
  id           String         @id @default(cuid())
  repoLinkId   String
  name         String
  /// Empty while only a `create` event has been seen: that payload carries no commit
  headSha      String
  deletedAt    DateTime?
  /// When GitHub says the newest push or deletion applied happened: an older one is skipped
  lastPushedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  repoLink     GithubRepoLink @relation(fields: [repoLinkId], references: [id], onDelete: Cascade)

  @@unique([repoLinkId, name])
  @@map("github_branches")
}

enum GithubPrState {
  OPEN
  CLOSED
  MERGED
}

model GithubPullRequest {
  id                 String         @id @default(cuid())
  repoLinkId         String
  number             Int
  title              String
  state              GithubPrState
  draft              Boolean
  authorLogin        String
  /// The connected Axiom user, else the integration user
  authorUserId       String?
  headRef            String
  headSha            String
  baseRef            String
  mergeableState     String?
  mergeCommitSha     String?
  /// [{ login, userId? }]
  requestedReviewers Json
  htmlUrl            String
  openedAt           DateTime
  mergedAt           DateTime?
  closedAt           DateTime?
  /// GitHub's `updated_at` of the newest payload applied: an older one never overwrites it
  githubUpdatedAt    DateTime
  /// When reconcile last asked GitHub for this PR as one stored open but no longer listed
  reconcileCheckedAt DateTime?
  /// How many such asks in a row were answered 404 (reset by any other answer)
  reconcileMisses    Int            @default(0)
  repoLink           GithubRepoLink @relation(fields: [repoLinkId], references: [id], onDelete: Cascade)
  reviews            GithubReview[]

  @@unique([repoLinkId, number])
  @@map("github_pull_requests")
}

model GithubReview {
  /// GitHub's review id
  id            String            @id
  pullRequestId String
  authorLogin   String
  authorUserId  String?
  state         String
  /// The first 4096 bytes
  body          String
  commitSha     String
  submittedAt   DateTime
  pullRequest   GithubPullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@map("github_reviews")
}

model GithubCommit {
  repoLinkId   String
  sha          String
  /// The first 2048 bytes
  message      String
  authorLogin  String?
  authorUserId String?
  htmlUrl      String
  committedAt  DateTime
  repoLink     GithubRepoLink @relation(fields: [repoLinkId], references: [id], onDelete: Cascade)

  @@id([repoLinkId, sha])
  @@map("github_commits")
}

/// A check run of a commit: the failed step and the end of its log are kept, so an agent reading
/// a ticket sees why CI failed
model GithubCheckRun {
  /// GitHub's check run id (for GitHub Actions also the job id)
  id                   String         @id
  repoLinkId           String
  headSha              String
  name                 String
  appSlug              String
  /// The check suite (for Actions the workflow run): a re-run stays in it, so it replaces its earlier run
  checkSuiteId         BigInt?
  /// Actions runs: from the job, for re-running the workflow
  workflowRunId        String?
  status               String
  conclusion           String?
  htmlUrl              String
  startedAt            DateTime?
  completedAt          DateTime?
  failedStep           String?
  logTail              String?
  logTruncated         Boolean        @default(false)
  logUnavailable       Boolean        @default(false)
  /// Why: not_found and gone are final; forbidden and unavailable are tried again (once an hour)
  logUnavailableReason String?
  /// When the log was last asked for
  logCheckedAt         DateTime?
  /// When the newest payload applied says it changed: an older one never overwrites it
  githubUpdatedAt      DateTime
  repoLink             GithubRepoLink @relation(fields: [repoLinkId], references: [id], onDelete: Cascade)

  @@index([repoLinkId, headSha])
  @@map("github_check_runs")
}
