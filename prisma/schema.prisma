generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity & Auth ────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  username     String  @unique
  displayName  String
  passwordHash String
  avatarUrl    String?

  // Platform admin
  isAdmin Boolean @default(false)

  // 2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deactivatedAt DateTime?

  notificationEmail String?

  // Relations
  apiTokens               ApiToken[]
  uploadIntents           UploadIntent[]
  orgMemberships          OrgMembership[]
  teamMemberships         TeamMembership[]
  assignedIssues          Issue[]                  @relation("assignee")
  createdIssues           Issue[]                  @relation("creator")
  comments                Comment[]
  pageEdits               PageVersion[]
  notifications           Notification[]
  attachments             Attachment[]
  activities              Activity[]
  pageComments            PageComment[]
  savedFilters            SavedFilter[]
  starredPages            StarredPage[]            @relation("UserStarredPages")
  pageViews               PageView[]               @relation("UserPageViews")
  issueVotes              IssueVote[]
  issueWebLinks           IssueWebLink[]
  notificationPreferences NotificationPreference[]
  watchedIssues           IssueWatcher[]
  sentInvitations         Invitation[]
  timeEntries             TimeEntry[]
  passwordResetTokens     PasswordResetToken[]
  pageRestrictions        PageRestriction[]        @relation("UserPageRestrictions")
  commentReactions        CommentReaction[]        @relation("UserCommentReactions")
  spacePermissions        SpacePermission[]        @relation("SpacePermissions")
  wikiPageIssueLinks      WikiPageIssueLink[]      @relation("WikiPageIssueLinks")
  approvalRequestsMade    ApprovalRequest[]        @relation("approvalRequester")
  approvalVotes           ApprovalVote[]
  formsCreated            Form[]                   @relation("formCreator")
  submissionsReviewed     FormSubmission[]         @relation("submissionReviewer")

  @@map("users")
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String // first 8 chars for identification
  scopes     String[] // e.g. ["issues:write", "wiki:read"]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  uploadIntents UploadIntent[]

  @@map("api_tokens")
}

model InviteLink {
  id        String       @id @default(cuid())
  code      String       @unique
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role      OrgRole      @default(MEMBER)
  createdBy String
  maxUses   Int          @default(1)
  uses      Int          @default(0)
  expiresAt DateTime?
  createdAt DateTime     @default(now())

  @@map("invite_links")
}

model Invitation {
  id        String       @id @default(cuid())
  email     String
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teamId    String?
  team      Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      String       @default("MEMBER")
  invitedBy String
  inviter   User         @relation(fields: [invitedBy], references: [id])
  status    String       @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  token     String       @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime     @default(now())

  @@index([email])
  @@index([orgId])
  @@map("invitations")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// ─── Organizations ──────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrgMembership[]
  teams       Team[]
  inviteLinks InviteLink[]
  invitations Invitation[]

  @@map("organizations")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  GUEST
}

model OrgMembership {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role   OrgRole      @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orgId])
  @@map("org_memberships")
}

// ─── Teams ──────────────────────────────────────────────────

model Team {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     TeamMembership[]
  projects    Project[]
  wikiSpaces  WikiSpace[]
  invitations Invitation[]

  @@unique([orgId, slug])
  @@map("teams")
}

enum TeamRole {
  ADMIN
  MEMBER
  VIEWER
}

model TeamMembership {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId String
  team   Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role   TeamRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, teamId])
  @@map("team_memberships")
}

// ─── Projects & Issues ──────────────────────────────────────

model Project {
  id          String  @id @default(cuid())
  teamId      String
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String? // markdown
  prefix      String // issue key prefix, e.g. "TICK"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issueTemplates Json? // JSON array of issue templates
  cardColorBy    String? // "priority", "type", or null

  issues                 Issue[]
  labels                 Label[]
  columns                BoardColumn[]
  sprints                Sprint[]
  milestones             Milestone[]
  customFieldDefinitions CustomFieldDefinition[]
  workflowRules          WorkflowRule[]
  automationRules        AutomationRule[]
  savedFilters           SavedFilter[]
  approvalGates          ApprovalGate[]
  forms                  Form[]
  formSubmissions        FormSubmission[]
  roadmapBuckets         RoadmapBucket[]

  @@unique([teamId, slug])
  @@unique([teamId, prefix])
  @@map("projects")
}

model BoardColumn {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  position  Int
  isDefault Boolean @default(false)
  isDone    Boolean @default(false)
  wipLimit  Int?

  issues                 Issue[]
  workflowRulesFrom      WorkflowRule[]    @relation("fromColumn")
  workflowRulesTo        WorkflowRule[]    @relation("toColumn")
  approvalGatesFrom      ApprovalGate[]    @relation("approvalGateFrom")
  approvalGatesTo        ApprovalGate[]    @relation("approvalGateTo")
  approvalRequestTargets ApprovalRequest[] @relation("approvalRequestTarget")

  @@index([projectId])
  @@map("board_columns")
}

enum IssueType {
  TASK
  BUG
  STORY
  EPIC
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Issue {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number     Int // sequential within project
  title      String
  body       String // markdown
  type       IssueType    @default(TASK)
  priority   Priority     @default(MEDIUM)
  columnId   String?
  column     BoardColumn? @relation(fields: [columnId], references: [id])
  assigneeId String?
  assignee   User?        @relation("assignee", fields: [assigneeId], references: [id])
  creatorId  String
  creator    User         @relation("creator", fields: [creatorId], references: [id])
  dueDate    DateTime?
  position   Int          @default(0) // ordering within column

  // Epic hierarchy & sprint planning
  parentId        String?
  parent          Issue?         @relation("issueHierarchy", fields: [parentId], references: [id])
  children        Issue[]        @relation("issueHierarchy")
  storyPoints     Int?
  sprintId        String?
  sprint          Sprint?        @relation(fields: [sprintId], references: [id])
  milestoneId     String?
  milestone       Milestone?     @relation(fields: [milestoneId], references: [id])
  timeEstimate    Int? // minutes
  timeSpent       Int? // minutes
  startDate       DateTime?
  roadmapBucketId String?
  roadmapBucket   RoadmapBucket? @relation(fields: [roadmapBucketId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labels            Label[]
  comments          Comment[]
  // Issue linking
  linksFrom         IssueLink[]          @relation("linkFrom")
  linksTo           IssueLink[]          @relation("linkTo")
  customFieldValues CustomFieldValue[]
  attachments       Attachment[]
  votes             IssueVote[]
  watchers          IssueWatcher[]
  webLinks          IssueWebLink[]
  timeEntries       TimeEntry[]
  sprintHistory     SprintIssueHistory[]
  wikiIssueLinks    WikiPageIssueLink[]
  approvalRequests  ApprovalRequest[]
  formSubmissions   FormSubmission[]

  @@unique([projectId, number])
  @@index([assigneeId])
  @@index([creatorId])
  @@map("issues")
}

model TimeEntry {
  id          String   @id @default(cuid())
  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  minutes     Int
  description String?
  loggedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([issueId])
  @@index([userId])
  @@map("time_entries")
}

model Label {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  color       String  @default("#6366f1")
  description String?

  issues Issue[]

  @@unique([projectId, name])
  @@map("labels")
}

enum LinkType {
  BLOCKS
  IS_BLOCKED_BY
  RELATES_TO
  DUPLICATES
}

model IssueLink {
  id     String   @id @default(cuid())
  fromId String
  from   Issue    @relation("linkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Issue    @relation("linkTo", fields: [toId], references: [id], onDelete: Cascade)
  type   LinkType

  createdAt DateTime @default(now())

  @@unique([fromId, toId, type])
  @@map("issue_links")
}

model Comment {
  id       String @id @default(cuid())
  issueId  String
  issue    Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  body     String // markdown

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]

  @@index([issueId])
  @@map("comments")
}

// ─── Wiki ───────────────────────────────────────────────────

model WikiSpace {
  id          String  @id @default(cuid())
  teamId      String
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  isArchived  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages         Page[]
  pageTemplates PageTemplate[]
  permissions   SpacePermission[]

  @@unique([teamId, slug])
  @@map("wiki_spaces")
}

enum SpacePermissionLevel {
  VIEW
  EDIT
  ADMIN
}

model SpacePermission {
  id       String               @id @default(cuid())
  spaceId  String
  space    WikiSpace            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?                @relation("SpacePermissions", fields: [userId], references: [id], onDelete: Cascade)
  teamRole String? // "ADMIN", "MEMBER", "VIEWER" -- applies to all users with this team role
  level    SpacePermissionLevel

  createdAt DateTime @default(now())

  @@unique([spaceId, userId])
  @@unique([spaceId, teamRole])
  @@index([spaceId])
  @@map("space_permissions")
}

model Page {
  id       String    @id @default(cuid())
  spaceId  String
  space    WikiSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Page?     @relation("pageTree", fields: [parentId], references: [id])
  children Page[]    @relation("pageTree")
  title    String
  slug     String
  body     String // markdown
  position Int       @default(0)
  isDraft  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions       PageVersion[]
  pageComments   PageComment[]
  pageLabels     PageLabel[]
  attachments    Attachment[]
  restrictions   PageRestriction[]
  starredBy      StarredPage[]
  views          PageView[]
  wikiIssueLinks WikiPageIssueLink[]
  pendingChange  PendingPageChange?

  @@unique([spaceId, slug])
  @@map("pages")
}

enum PageVersionKind {
  EDIT
  EXTERNAL
  SESSION_DRAFT
  MERGE
  RESTORE
}

model PageVersion {
  id                String          @id @default(cuid())
  pageId            String
  page              Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version           Int
  title             String
  body              String // markdown
  authorId          String
  author            User            @relation(fields: [authorId], references: [id])
  changeDescription String?
  kind              PageVersionKind @default(EDIT)

  createdAt DateTime @default(now())

  pendingChanges PendingPageChange[] @relation("PendingExternalVersion")
  pendingDrafts  PendingPageChange[] @relation("PendingDraftVersion")

  @@unique([pageId, version])
  @@map("page_versions")
}

/// An external change to a page that is waiting to be merged into an open collaborative session.
model PendingPageChange {
  id                String       @id @default(cuid())
  pageId            String       @unique
  page              Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  baseBody          String
  externalVersionId String
  externalVersion   PageVersion  @relation("PendingExternalVersion", fields: [externalVersionId], references: [id], onDelete: Cascade)
  authorId          String
  /// The latest SESSION_DRAFT saved by a session opened before the change: the unmerged work
  /// that keeps this change pending after that session ended
  draftVersionId    String?
  draftVersion      PageVersion? @relation("PendingDraftVersion", fields: [draftVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([draftVersionId])
  @@map("pending_page_changes")
}

// ─── Notifications ──────────────────────────────────────────

model Notification {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String // e.g. "issue:assigned", "mention"
  title  String
  body   String?
  link   String? // deep link within app
  read   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String // e.g. "issue_assigned", "issue_commented", "mention"
  inApp     Boolean @default(true)
  email     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventType])
  @@map("notification_preferences")
}

enum WikiIssueLinkType {
  MENTION
  EMBED
}

model WikiPageIssueLink {
  id          String            @id @default(cuid())
  pageId      String
  page        Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  issueId     String
  issue       Issue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  linkType    WikiIssueLinkType
  createdAt   DateTime          @default(now())
  createdById String
  createdBy   User              @relation("WikiPageIssueLinks", fields: [createdById], references: [id])

  @@unique([pageId, issueId, linkType])
  @@index([pageId])
  @@index([issueId])
  @@map("wiki_page_issue_links")
}

// ─── Audit Log ──────────────────────────────────────────────

model AuditLog {
  id         String  @id @default(cuid())
  orgId      String
  userId     String?
  action     String // e.g. "team.create", "issue.delete", "member.role_change"
  resource   String // e.g. "team:cuid123"
  details    Json? // additional context
  apiTokenId String?
  via        String?

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("audit_logs")
}

// ─── Platform Expansion Enums ────────────────────────────────

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum SprintIssueAction {
  ADDED
  REMOVED
}

// ─── Platform Expansion Models ───────────────────────────────

model Sprint {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  goal        String?
  startDate   DateTime
  endDate     DateTime
  status      SprintStatus @default(PLANNING)
  committedAt DateTime?
  createdAt   DateTime     @default(now())

  issues       Issue[]
  issueHistory SprintIssueHistory[]

  @@index([projectId])
  @@map("sprints")
}

model SprintIssueHistory {
  id        String            @id @default(cuid())
  sprintId  String
  sprint    Sprint            @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  issueId   String
  issue     Issue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  action    SprintIssueAction
  timestamp DateTime          @default(now())

  @@index([sprintId])
  @@index([issueId])
  @@map("sprint_issue_history")
}

model CustomFieldDefinition {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      String // TEXT, NUMBER, DATE, SELECT, MULTI_SELECT, USER
  options   Json? // for select types
  required  Boolean @default(false)
  position  Int     @default(0)

  values CustomFieldValue[]

  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id                String                @id @default(cuid())
  issueId           String
  issue             Issue                 @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fieldDefinitionId String
  fieldDefinition   CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  value             String

  @@unique([issueId, fieldDefinitionId])
  @@map("custom_field_values")
}

model WorkflowRule {
  id             String      @id @default(cuid())
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromColumnId   String
  fromColumn     BoardColumn @relation("fromColumn", fields: [fromColumnId], references: [id], onDelete: Cascade)
  toColumnId     String
  toColumn       BoardColumn @relation("toColumn", fields: [toColumnId], references: [id], onDelete: Cascade)
  requiredFields Json?
  createdAt      DateTime    @default(now())

  @@unique([projectId, fromColumnId, toColumnId])
  @@map("workflow_rules")
}

model AutomationRule {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  trigger    String
  condition  String?
  conditions Json?
  actions    Json
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("automation_rules")
}

model Attachment {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  issueId      String?
  issue        Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pageId       String?
  page         Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  /// Set while the upload has no parent yet; a body write that references it binds it
  stagedAt     DateTime?
  createdAt    DateTime @default(now())

  @@index([uploaderId, stagedAt])
  @@index([stagedAt])
  @@map("attachments")
}

/// A signed upload URL. A revoked token or a removed user takes its URLs along
model UploadIntent {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiTokenId   String?
  apiToken     ApiToken? @relation(fields: [apiTokenId], references: [id], onDelete: Cascade)
  /// The parent as { issueId } or { pageId }; null stages the upload
  target       Json?
  filename     String
  mimeType     String
  maxBytes     Int
  expiresAt    DateTime
  usedAt       DateTime?
  /// Reserved when the URL is made, so that its caller knows the attachment's URL in advance
  attachmentId String
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
  @@map("upload_intents")
}

model Activity {
  id           String   @id @default(cuid())
  resourceType String
  resourceId   String
  action       String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  details      Json?
  apiTokenId   String?
  via          String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("activities")
}

model PageComment {
  id         String   @id @default(cuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  anchorText String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  reactions CommentReaction[]

  @@index([pageId])
  @@map("page_comments")
}

model CommentReaction {
  id           String      @id @default(cuid())
  commentId    String
  comment      PageComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation("UserCommentReactions", fields: [userId], references: [id])
  reactionType String
  createdAt    DateTime    @default(now())

  @@unique([commentId, userId, reactionType])
  @@index([commentId])
  @@map("comment_reactions")
}

model PageLabel {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  label  String

  @@unique([pageId, label])
  @@map("page_labels")
}

enum RestrictionType {
  VIEW
  EDIT
}

model PageRestriction {
  id          String          @id @default(cuid())
  pageId      String
  page        Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type        RestrictionType
  userId      String?
  user        User?           @relation("UserPageRestrictions", fields: [userId], references: [id])
  teamRoleMin TeamRole?
  createdAt   DateTime        @default(now())

  @@unique([pageId, type, userId])
  @@index([pageId])
  @@map("page_restrictions")
}

model PageTemplate {
  id          String    @id @default(cuid())
  spaceId     String
  space       WikiSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  body        String
  description String?
  isBuiltIn   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("page_templates")
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  query     Json
  createdAt DateTime @default(now())

  @@map("saved_filters")
}

// ─── Issue Votes ────────────────────────────────────────────

model IssueVote {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([issueId, userId])
  @@map("issue_votes")
}

model IssueWebLink {
  id          String   @id @default(cuid())
  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  url         String
  title       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([issueId])
  @@map("issue_web_links")
}

// ─── Milestones ─────────────────────────────────────────────

enum MilestoneStatus {
  OPEN
  CLOSED
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  status      MilestoneStatus @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  issues Issue[]

  @@unique([projectId, title])
  @@map("milestones")
}

// ─── Issue Watchers ─────────────────────────────────────────

model IssueWatcher {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([issueId, userId])
  @@map("issue_watchers")
}

// ─── Starred Pages ──────────────────────────────────────────

model StarredPage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserStarredPages", fields: [userId], references: [id], onDelete: Cascade)
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, pageId])
  @@index([userId])
  @@map("starred_pages")
}

// ─── Page Views ─────────────────────────────────────────────

model PageView {
  id       String   @id @default(cuid())
  pageId   String
  page     Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("UserPageViews", fields: [userId], references: [id])
  viewedAt DateTime @default(now())

  @@index([pageId])
  @@index([userId])
  @@index([pageId, viewedAt])
  @@map("page_views")
}

// ─── Approval Workflows ─────────────────────────────────────

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model ApprovalGate {
  id                String   @id @default(cuid())
  projectId         String
  fromColumnId      String
  toColumnId        String
  minApprovals      Int      @default(1)
  allowSelfApproval Boolean  @default(false)
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromColumn BoardColumn       @relation("approvalGateFrom", fields: [fromColumnId], references: [id], onDelete: Cascade)
  toColumn   BoardColumn       @relation("approvalGateTo", fields: [toColumnId], references: [id], onDelete: Cascade)
  requests   ApprovalRequest[]

  @@unique([projectId, fromColumnId, toColumnId])
  @@index([projectId])
  @@map("approval_gates")
}

model ApprovalRequest {
  id             String                @id @default(cuid())
  issueId        String
  approvalGateId String
  targetColumnId String
  requestedById  String
  /// The users asked to approve; only they can vote
  approverIds    String[]              @default([])
  status         ApprovalRequestStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  resolvedAt     DateTime?

  issue        Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  approvalGate ApprovalGate   @relation(fields: [approvalGateId], references: [id], onDelete: Cascade)
  targetColumn BoardColumn    @relation("approvalRequestTarget", fields: [targetColumnId], references: [id], onDelete: Cascade)
  requestedBy  User           @relation("approvalRequester", fields: [requestedById], references: [id])
  votes        ApprovalVote[]

  @@index([issueId])
  @@index([approvalGateId])
  @@index([requestedById, status])
  @@map("approval_requests")
}

model ApprovalVote {
  id                String           @id @default(cuid())
  approvalRequestId String
  userId            String
  decision          ApprovalDecision
  comment           String?
  createdAt         DateTime         @default(now())

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])

  @@unique([approvalRequestId, userId])
  @@index([userId])
  @@map("approval_votes")
}

// ─── Public Intake Forms ─────────────────────────────────────

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormAuthMode {
  PUBLIC
  TOKEN_GATED
}

enum FormSpamProtection {
  NONE
  CAPTCHA
  RATE_LIMIT
}

enum FormFieldType {
  TEXT
  TEXTAREA
  SELECT
  MULTISELECT
  CHECKBOX
  RADIO
  DATE
  FILE
  HEADING
  DESCRIPTION
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

model Form {
  id               String             @id @default(cuid())
  projectId        String
  name             String
  slug             String             @unique
  description      String?
  status           FormStatus         @default(DRAFT)
  authMode         FormAuthMode       @default(PUBLIC)
  sharedSecret     String?
  spamProtection   FormSpamProtection @default(NONE)
  rateLimitPerHour Int?
  successMessage   String?
  redirectUrl      String?
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("formCreator", fields: [createdById], references: [id])
  pages       FormPage[]
  submissions FormSubmission[]

  @@index([projectId])
}

model FormPage {
  id                String  @id @default(cuid())
  formId            String
  title             String
  position          Int
  conditionFieldId  String?
  conditionOperator String?
  conditionValue    String?

  form           Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  conditionField FormField?  @relation("pageCondition", fields: [conditionFieldId], references: [id], onDelete: SetNull)
  fields         FormField[] @relation("pageFields")

  @@index([formId])
}

model FormField {
  id                String        @id @default(cuid())
  formPageId        String
  position          Int
  type              FormFieldType
  label             String
  placeholder       String?
  helpText          String?
  required          Boolean       @default(false)
  options           Json?
  issueFieldMapping String?
  validationRules   Json?

  page           FormPage   @relation("pageFields", fields: [formPageId], references: [id], onDelete: Cascade)
  conditionPages FormPage[] @relation("pageCondition")

  @@index([formPageId])
}

model FormSubmission {
  id             String           @id @default(cuid())
  formId         String
  projectId      String
  status         SubmissionStatus @default(PENDING)
  data           Json
  submitterEmail String?
  submitterName  String?
  submitterIp    String
  issueId        String?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime         @default(now())

  form       Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue      Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)
  reviewedBy User?   @relation("submissionReviewer", fields: [reviewedById], references: [id])

  @@index([formId, status])
  @@index([projectId, status])
}

// ─── Roadmap ─────────────────────────────────────────────

model RoadmapBucket {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  Int
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
  @@map("roadmap_buckets")
}

// ─── Site Settings (singleton) ──────────────────────────────

model SiteSettings {
  id               Int      @id @default(1)
  heroTitle        String   @default("Code. Track. Document.")
  heroSubtitle     String   @default("Git hosting, issue tracking, and documentation — unified with built-in AI integration.")
  ctaText          String   @default("Get Started")
  ctaLink          String   @default("/register")
  bodyMarkdown     String   @default("")
  registrationMode String   @default("INVITE_ONLY") @map("registration_mode")
  enforce2fa       Boolean  @default(false) @map("enforce_2fa")
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}
