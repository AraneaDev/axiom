  spaceId     String
  space       WikiSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  body        String
  description String?
  isBuiltIn   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("page_templates")
}

enum SavedVisibility {
  PRIVATE
  TEAM
  ORG
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  query     Json
  createdAt DateTime @default(now())

  // Sharing: PRIVATE is the creator only, TEAM needs teamId, ORG needs orgId
  visibility  SavedVisibility @default(PRIVATE)
  description String?
  teamId      String?
  team        Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orgId       String?
  org         Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  widgets DashboardWidget[]

  @@index([teamId])
  @@index([orgId])
  @@map("saved_filters")
}

// ─── Dashboards ─────────────────────────────────────────────

enum WidgetType {
  TABLE
  COUNT
  BAR
  LIST
  SPRINT_OVERVIEW
}

model Dashboard {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Sharing, as on saved queries: PRIVATE is the owner only, TEAM needs teamId, ORG needs orgId
  visibility SavedVisibility @default(PRIVATE)
  teamId     String?
  team       Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orgId      String?
  org        Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  layout  Json              @default("{}")
  widgets DashboardWidget[]

  @@index([ownerId])
  @@index([teamId])
  @@index([orgId])
  @@map("dashboards")
}

model DashboardWidget {
  id           String       @id @default(cuid())
  dashboardId  String
  dashboard    Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  // A saved query or an inline query; a sprint overview has neither. A deleted saved query leaves
  // the widget without one, which renders as that widget's error
  savedQueryId String?
  savedQuery   SavedFilter? @relation(fields: [savedQueryId], references: [id], onDelete: SetNull)
  query        String?
  type         WidgetType
  title        String
  options      Json         @default("{}")
  position     Int

  @@index([dashboardId, position])
  @@index([savedQueryId])
  @@map("dashboard_widgets")
}

